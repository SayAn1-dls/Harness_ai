# Local development only. Copy to .env (gitignored) or simply `export AI_API_KEY=...`.
# Never put a real credential in this file or any committed file.
AI_API_KEY=

# Optional overrides of lcc.config.toml (no secrets):
# LCC_PROVIDER=auto        # auto | deepseek | qwen | qwen-cn | gemini | openai | anthropic | openrouter | groq | grok | custom
# LCC_MODEL=               # pin a model, e.g. deepseek-chat, deepseek-reasoner, qwen3-coder-plus, qwen-plus
# LCC_BASE_URL=            # any OpenAI-compatible endpoint (sets provider=custom when provider=auto)
# GITHUB_TOKEN=            # optional: higher rate limit when fetching GitHub issues
